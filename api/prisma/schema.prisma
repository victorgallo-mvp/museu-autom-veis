generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  id                       Int      @id @default(1)
  ticketPrice              Decimal  @default(60.00) @db.Decimal(10, 2)
  guideCommissionPerPerson Decimal  @default(15.00) @db.Decimal(10, 2)
  cachacaPrice             Decimal  @default(0) @db.Decimal(10, 2)
  cachacaCommission        Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt                DateTime @updatedAt
}

model Booking {
  id                      String        @id @default(uuid())
  groupName               String
  responsibleName         String
  responsiblePhone        String
  scheduledAt             DateTime
  expectedPeopleCount     Int           @map("peopleCount")
  actualPeopleCount       Int?
  ticketPriceSnapshot     Decimal       @db.Decimal(10, 2)
  guideCommissionSnapshot Decimal       @db.Decimal(10, 2)
  status                  BookingStatus @default(PENDING)
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

enum BookingStatus {
  PENDING
  PAID
  CANCELED
  NO_SHOW
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  paidAt      DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paidAt])
}

enum PayoutCategory {
  VISITS
  PRODUCTS
  GENERAL
}

model Payout {
  id        String         @id @default(uuid())
  category  PayoutCategory
  amount    Decimal        @db.Decimal(10, 2)
  paidAt    DateTime
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([paidAt])
}

model CachacaSale {
  id                 String   @id @default(uuid())
  soldAt             DateTime
  bottleCount        Int
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2)
  commissionSnapshot Decimal  @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([soldAt])
}
